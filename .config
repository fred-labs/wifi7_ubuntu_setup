# -------- Driver / kernel interface --------
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# -------- Control interface (needed for ctrl_interface=...) --------
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_UNIX=y
CONFIG_BACKEND=file

# -------- Wi-Fi standards --------
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211BE=y     # Wi-Fi 7 / MLO

# -------- WPA3 / Security --------
CONFIG_SAE=y
# CONFIG_IEEE80211W=y      # PMF support
# CONFIG_PMKSA_CACHE_EXTERNAL=y

# -------- TLS / crypto backend --------
CONFIG_TLS=openssl
CONFIG_ECC=y

# -------- Optional: DBus interface for NetworkManager --------
CONFIG_CTRL_IFACE_DBUS=y
# CONFIG_CTRL_IFACE_DBUS_NEW=y

# -------- Optional: P2P (needed only if you want p2p_disabled=1 in config) --------
# CONFIG_P2P=y

# -------- Debugging --------
# CONFIG_DEBUG_SYSLOG=y
# CONFIG_DEBUG_FILE=y
